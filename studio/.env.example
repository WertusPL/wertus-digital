# Contact form — SMTP transport (server-side only).
# Copy this file to .env.local and fill in real values. NEVER commit real secrets.
# .env.local is gitignored; this .env.example is safe to commit (no secrets).

# SMTP server host.
#   Google Workspace: smtp.gmail.com
#   (or your provider's host)
SMTP_HOST=

# SMTP port: 465 for implicit TLS (SMTP_SECURE=true), 587 for STARTTLS (SMTP_SECURE=false).
SMTP_PORT=

# true for port 465, false for 587. Optional — if omitted it is inferred from the port.
SMTP_SECURE=

# SMTP username — usually the full mailbox address, e.g. wertusdigital@gmail.com
SMTP_USER=

# SMTP password.
#   Gmail / Google Workspace: use an App Password (requires 2-Step Verification), NOT the account password.
SMTP_PASS=

# Where enquiries are delivered. Optional — defaults to wertusdigital@gmail.com.
CONTACT_TO_EMAIL=wertusdigital@gmail.com

# The From address — must be authorised by the SMTP account (SPF/DKIM/DMARC).
# Optional — defaults to SMTP_USER. The visitor's address is set as Reply-To automatically.
CONTACT_FROM_EMAIL=
